# Copy these into your shell (or your IDE's run configuration). Never commit real keys.
# Pendant reads them from the environment; it does not load .env files by itself.
OPENAI_API_KEY=your-openai-api-key-here

# Optional
# PENDANT_API=responses              # responses | chat
# PENDANT_PROVIDER=auto              # auto | openai | offline
# PENDANT_MODEL=gpt-5-mini           # default model for every agent
# PENDANT_MODEL_COMPOSER=gpt-5-mini       # per-agent override (COMPOSER, DRUMS, BASS, CHORDS, MELODY, CRITIC)
# PENDANT_MAX_API_CALLS=60           # global cap per run
# PENDANT_MAX_RETRIES=2
# PENDANT_CRITIC_ROUNDS=2
# PENDANT_REASONING_EFFORT=low
# FLUIDSYNTH=tools/fluidsynth/bin/fluidsynth
# PENDANT_SOUNDFONT=soundfonts/FluidR3_GM.sf2
